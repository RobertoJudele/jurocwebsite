# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit credentials.

# --- Where the service listens (nginx proxies to this) ---
PORT=3001

# --- SMTP relay for the juroc.tech mailbox ---
# Look these up in your mail provider's settings. Common values:
#   Google Workspace : smtp.gmail.com        port 465 secure=true  (requires an App Password)
#   Zoho Mail        : smtp.zoho.eu          port 465 secure=true
#   Migadu           : smtp.migadu.com       port 465 secure=true
#   Microsoft 365    : smtp.office365.com    port 587 secure=false
#
# PORT 465 vs 587: 465 is implicit TLS (secure=true), 587 is STARTTLS
# (secure=false). Both are fine and both are encrypted — 587 negotiates the
# TLS upgrade after connecting rather than starting encrypted.
#
# On this VPS (Hetzner nbg1) port 465 is BLOCKED outbound while 587 is open,
# so Google Workspace is configured on 587 here. Verified 2026-07-28 with:
#   timeout 8 bash -c 'cat < /dev/null > /dev/tcp/smtp.gmail.com/465'
# If verify-smtp.js ever hangs or times out, test the port that way before
# touching anything else — a blocked port looks exactly like bad config.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=robertojudele@juroc.tech
SMTP_PASS=

# --- Addressing ---
# The envelope sender. Must be an address your SMTP account is allowed to send as,
# otherwise the provider will reject the message.
MAIL_FROM=robertojudele@juroc.tech
MAIL_FROM_NAME=Juroc Solutions

# Where enquiries are delivered.
MAIL_TO=robertojudele@juroc.tech

# --- CORS ---
# Comma-separated list of origins allowed to POST the form.
# Same-origin deployments do not strictly need this, but it is here for staging hosts.
ALLOWED_ORIGINS=https://juroc.tech,https://www.juroc.tech
